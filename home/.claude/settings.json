{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_TOASTY_THIMBLE": "0",
    "CLAUDE_CODE_GENTLE_PARASOL": "0"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Fetch",
      "Search",
      "Read",
      "Bash(just:*)",
      "Bash(pnpm:*)",
      "Bash(docker:*)",
      "Bash(go:*)",
      "Bash(./bin:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(cat:*)",
      "Bash(lsof:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(gh:*)",
      "Bash(jq:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "/Users/mknopf/code/github/savi/claude-code-plugins/plugins/mk/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "firebase@firebase": false,
    "figma@claude-plugins-official": true,
    "savi@savi-live": true,
    "mk@savi-live": true
  },
  "extraKnownMarketplaces": {
    "marimo-pair": {
      "source": {
        "source": "github",
        "repo": "marimo-team/marimo-pair"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    },
    "firebase": {
      "source": {
        "source": "github",
        "repo": "firebase/firebase-tools"
      }
    },
    "savi-live": {
      "source": {
        "source": "directory",
        "path": "/Users/mknopf/.claude/local-marketplaces/savi-live"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "awaySummaryEnabled": true,
  "showClearContextOnPlanAccept": true,
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "allowedTools": [
    "Search",
    "Read",
    "WebSearch"
  ]
}
