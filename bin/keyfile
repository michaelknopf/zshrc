#!/usr/bin/env python3
"""keyfile — central store for low-sensitivity API keys used by local dev and agents.

The store is a .env-style file divided into groups by `# [group]` headers; keys
above the first header belong to the group "default". Groups exist so a consumer
takes only what it needs: `keyfile run notion -- ./script` puts NOTION_TOKEN in
the environment and nothing else.

Subcommands:
  get <KEY>                 print one value
  list [group...]           print key names (never values)
  groups                    print group names
  env [group...]            print 'export K=V' lines for eval
  run [group...] -- <cmd>   run <cmd> with those keys in its environment
  edit                      open the store in $EDITOR
  init                      create a store from a starter template
  path                      print the store's location

Values are for keys that are rotated often, usage-capped and permission-scoped;
the store is not a vault. Override its location with KEYFILE_PATH.
"""

import argparse
import os
import re
import shlex
import stat
import subprocess
import sys
import typing
from pathlib import Path

DEFAULT_STORE = Path.home() / '.local' / 'share' / 'agent-keys' / 'keys.env'
DEFAULT_GROUP = 'default'

GROUP_HEADER = re.compile(r'^\s*#\s*\[(?P<name>.*?)\]\s*$')
ENTRY = re.compile(r'^\s*(?:export\s+)?(?P<key>[A-Za-z_][A-Za-z0-9_]*)\s*=(?P<value>.*)$')

TEMPLATE = """\
# API keys for local development and agent use.
# Low-sensitivity only: rotated frequently, with usage caps and scoped permissions.
# Group keys with `# [group]` headers; read them with `keyfile get|env|run`.

# [example]
EXAMPLE_API_KEY=replace-me
"""


class Entry(typing.NamedTuple):
    group: str
    key: str
    value: str
    line: int


def die(msg: str, code: int = 1) -> typing.NoReturn:
    print(f'keyfile: {msg}', file=sys.stderr)
    sys.exit(code)


def store_path() -> Path:
    return Path(os.environ.get('KEYFILE_PATH', DEFAULT_STORE))


def _unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ('"', "'"):
        return value[1:-1]
    return value


def parse(text: str) -> list[Entry]:
    entries: list[Entry] = []
    group = DEFAULT_GROUP
    for lineno, raw in enumerate(text.splitlines(), 1):
        if header := GROUP_HEADER.match(raw):
            group = header.group('name').strip() or DEFAULT_GROUP
            continue
        if not raw.strip() or raw.lstrip().startswith('#'):
            continue
        if entry := ENTRY.match(raw):
            entries.append(
                Entry(group, entry.group('key'), _unquote(entry.group('value')), lineno)
            )
    return entries


def load() -> list[Entry]:
    path = store_path()
    if not path.is_file():
        die(f"no key store at {path} (run 'keyfile init')")
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode != 0o600:
        die(f'{path} has mode {mode:03o}, expected 600 (run: chmod 600 "{path}")')
    entries = parse(path.read_text())
    _assert_no_conflicts(entries, path)
    return entries


def _assert_no_conflicts(entries: list[Entry], path: Path) -> None:
    """
    A key bound to two different values resolves inconsistently — `get` would
    take the first and `env`/`run` the last — so refuse rather than pick. The
    same value repeated under two names is an intentional alias and stays legal.
    """
    seen: dict[str, Entry] = {}
    for entry in entries:
        prior = seen.get(entry.key)
        if prior is not None and prior.value != entry.value:
            die(
                f'{entry.key} is defined twice with different values '
                f'({path}:{prior.line} and :{entry.line})'
            )
        seen.setdefault(entry.key, entry)


def select(entries: list[Entry], groups: list[str]) -> list[Entry]:
    if not groups:
        return entries
    known = {e.group for e in entries}
    selected: list[Entry] = []
    for group in groups:
        if group not in known:
            die(f"no such group: {group} (see 'keyfile groups')")
        selected.extend(e for e in entries if e.group == group)
    return selected


def cmd_get(args: argparse.Namespace) -> None:
    for entry in load():
        if entry.key == args.key:
            print(entry.value)
            return
    die(f"no such key: {args.key} (see 'keyfile list')")


def cmd_list(args: argparse.Namespace) -> None:
    entries = select(load(), args.groups)
    if args.groups:
        for key in sorted({e.key for e in entries}):
            print(key)
    else:
        for key, group in sorted({(e.key, e.group) for e in entries}):
            print(f'{key}\t{group}')


def cmd_groups(_args: argparse.Namespace) -> None:
    for group in sorted({e.group for e in load()}):
        print(group)


def cmd_env(args: argparse.Namespace) -> None:
    for entry in select(load(), args.groups):
        print(f'export {entry.key}={shlex.quote(entry.value)}')


def cmd_run(args: argparse.Namespace) -> None:
    if not args.command:
        die('usage: keyfile run [group...] -- <command> [args...]')
    env = os.environ | {e.key: e.value for e in select(load(), args.groups)}
    try:
        completed = subprocess.run(args.command, env=env)
    except FileNotFoundError:
        die(f'command not found: {args.command[0]}', 127)
    except PermissionError:
        die(f'not executable: {args.command[0]}', 126)
    sys.exit(completed.returncode)


def cmd_edit(_args: argparse.Namespace) -> None:
    # Deliberately no load(): a store that fails validation — loose perms, or a
    # conflicting key — is exactly the one needing an edit, so checking here
    # would lock the user out of the only command that repairs it.
    path = store_path()
    if not path.is_file():
        die(f"no key store at {path} (run 'keyfile init')")
    editor = os.environ.get('EDITOR', 'vi')
    completed = subprocess.run([*shlex.split(editor), str(path)])
    if not path.is_file():
        die(f'{path} is gone after editing; the store was not saved')
    # An editor that saves by rename can leave a fresh file with default perms.
    path.chmod(0o600)
    sys.exit(completed.returncode)


def cmd_init(_args: argparse.Namespace) -> None:
    path = store_path()
    if path.exists():
        print(f'keyfile: store already exists at {path}')
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    path.write_text(TEMPLATE)
    path.chmod(0o600)
    print(f'keyfile: created {path}')


def cmd_path(_args: argparse.Namespace) -> None:
    print(store_path())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog='keyfile', description=(__doc__ or '').splitlines()[0]
    )
    sub = parser.add_subparsers(dest='command', required=True)

    p_get = sub.add_parser('get', help='print one value')
    p_get.add_argument('key')
    p_get.set_defaults(func=cmd_get)

    p_list = sub.add_parser('list', help='print key names, never values')
    p_list.add_argument('groups', nargs='*')
    p_list.set_defaults(func=cmd_list)

    sub.add_parser('groups', help='print group names').set_defaults(func=cmd_groups)

    p_env = sub.add_parser('env', help="print 'export K=V' lines for eval")
    p_env.add_argument('groups', nargs='*')
    p_env.set_defaults(func=cmd_env)

    p_run = sub.add_parser('run', help='run a command with those keys in its environment')
    p_run.add_argument('groups', nargs='*')
    p_run.set_defaults(func=cmd_run, command=[])

    sub.add_parser('edit', help='open the store in $EDITOR').set_defaults(func=cmd_edit)
    sub.add_parser(
        'init', help='create a store from a starter template'
    ).set_defaults(func=cmd_init)
    sub.add_parser('path', help="print the store's location").set_defaults(func=cmd_path)
    return parser


def main() -> None:
    argv = sys.argv[1:]
    # Split on the FIRST `--` ourselves: everything after it is the child's
    # argv and must reach it untouched, including any further `--` of its own.
    child: list[str] = []
    if argv[:1] == ['run'] and '--' in argv:
        split = argv.index('--')
        argv, child = argv[:split], argv[split + 1 :]

    args = build_parser().parse_args(argv)
    if args.func is cmd_run:
        args.command = child
    args.func(args)


if __name__ == '__main__':
    main()
