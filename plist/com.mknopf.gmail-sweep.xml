<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Every 15 minutes, 8am-11pm. launchd uses local time, so these track Pacific incl. DST.

  Fires this often because `gws` credentials expire daily and a sweep needs an hour that
  follows a manual `gws_auth` — more attempts means less of the day spent unswept. The
  script self-guards on a date-stamped state file, so at most one real sweep runs per day
  and every other firing is a cheap no-op. See bin/internal/gmail-sweep.sh.

  No RunAtLoad — a sweep archives mail, and login is not a reason to trigger one.
-->
<dict>
    <key>Label</key>
    <string>com.mknopf.gmail-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mknopf/code/github/michaelknopf/zshrc/bin/internal/gmail-sweep.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's default PATH omits /opt/homebrew/bin, where gws and python3 live. -->
        <key>PATH</key>
        <string>/Users/mknopf/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
