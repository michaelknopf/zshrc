<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  TEMPORARY (2026-08-01): StartInterval of 300s while observing the job in the wild.
  The intended schedule is StartCalendarInterval at Hour 8..23, Minute 0 — hourly across
  waking hours, local time so it tracks Pacific incl. DST. Restore that and drop
  StartInterval when the observation window is over.

  Either way the script self-guards: it exits immediately if the sweep already succeeded
  today, so at most one real sweep runs per day and the extra firings are cheap no-ops.
  See bin/internal/gmail-sweep.sh for why the schedule is opportunistic at all.

  No RunAtLoad — a sweep archives mail, and login is not a reason to trigger one.
-->
<dict>
    <key>Label</key>
    <string>com.mknopf.gmail-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mknopf/code/github/michaelknopf/zshrc/bin/internal/gmail-sweep.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd's default PATH omits /opt/homebrew/bin, where gws and python3 live. -->
        <key>PATH</key>
        <string>/Users/mknopf/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/gmail-sweep-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/gmail-sweep-launchd.log</string>
</dict>
</plist>
